#!/usr/bin/env bash

USER_ID="$(id -u)"
SOCKET="/tmp/rudyplay_${USER_ID}.sock"
SRCFILE="/tmp/rudyplay_${USER_ID}.source"

# Dependencies
for cmd in mpv yt-dlp socat pgrep pkill; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "RudyPlay error: missing dependency $cmd"
        exit 1
    }
done

# Helpers
is_youtube_url() {
    [[ "$1" =~ ^https?:// ]]
}

mpv_running() {
    pgrep -u "$USER_ID" -x mpv >/dev/null
}

kill_all_mpv() {
    pkill -u "$USER_ID" -x mpv 2>/dev/null
}

mpv_cmd() {
    echo "$1" | socat - "$SOCKET" 2>/dev/null
}

mpv_get() {
    mpv_cmd "{ \"command\": [\"get_property\", \"$1\"] }"
}

json_value() {
    sed -n 's/.*"data":[ ]*\([^,}]*\).*/\1/p'
}

format_time() {
    local t=${1%.*}
    printf "%02d:%02d" $((t/60)) $((t%60))
}

wait_for_socket() {
    for _ in {1..50}; do
        [[ -S "$SOCKET" ]] && return 0
        sleep 0.1
    done
    return 1
}

# Commands
start_player() {
    local input="$1"

    [[ -n "$input" ]] || {
        echo "Usage: rudyplay start <url|file>"
        exit 1
    }

    # HARD STOP anything already playing
    kill_all_mpv
    rm -f "$SOCKET"

    # Validate
    if [[ -f "$input" ]] || is_youtube_url "$input"; then
        echo "$input" > "$SRCFILE"
    else
        echo "RudyPlay error: invalid URL or file"
        exit 1
    fi

    # Start mpv — fully detached, single instance
    nohup mpv \
        --no-video \
        --no-terminal \
        --really-quiet \
        --input-ipc-server="$SOCKET" \
        --ytdl-format=bestaudio \
        "$input" \
        >/dev/null 2>&1 &

    if ! wait_for_socket; then
        kill_all_mpv
        rm -f "$SOCKET" "$SRCFILE"
        echo "RudyPlay error: failed to start"
        exit 1
    fi

    echo -e "\e[32m▶ RudyPlay — Playing\e[0m"
}

stop_player() {
    if mpv_running; then
        kill_all_mpv
        rm -f "$SOCKET" "$SRCFILE"
        echo -e "\e[31m■ Stopped\e[0m"
    else
        echo -e "\e[31mRudyPlay not running\e[0m"
    fi
}

pause_player() {
    mpv_running || { echo "RudyPlay not running"; exit 1; }
    mpv_cmd '{ "command": ["set_property", "pause", true] }'
    echo -e "\e[33m⏸ Paused\e[0m"
}

resume_player() {
    mpv_running || { echo "RudyPlay not running"; exit 1; }
    mpv_cmd '{ "command": ["set_property", "pause", false] }'
    echo -e "\e[32m▶ Playing\e[0m"
}

status_player() {
    if ! mpv_running; then
        echo -e "\e[31m■ Stopped\e[0m"
        return
    fi

    local pos dur src
    src=$(cat "$SRCFILE" 2>/dev/null)
    pos=$(mpv_get playback-time | json_value)
    dur=$(mpv_get duration | json_value)

    if [[ -z "$pos" || -z "$dur" ]]; then
        echo -e "\e[31m■ Stopped\e[0m"
        return
    fi

    echo -e "\e[32m▶ RudyPlay\e[0m  Time: \e[33m$(format_time "$pos")\e[0m / \e[36m$(format_time "$dur")\e[0m"
    echo -e "Source: \e[35m$src\e[0m"
}

# Entry
case "$1" in
    start)  start_player "$2" ;;
    stop)   stop_player ;;
    pause)  pause_player ;;
    resume) resume_player ;;
    status) status_player ;;
    *)
        echo "Commands:"
        echo "  rudyplay start <url|file>"
        echo "  rudyplay pause"
        echo "  rudyplay resume"
        echo "  rudyplay stop"
        echo "  rudyplay status"
        ;;
esac
